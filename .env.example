# Copia este archivo a .env y ajusta los valores reales.
#   cp .env.example .env

# URL base del backend Laravel local (incluye el prefijo /api)
VITE_API_URL=http://127.0.0.1:8000/api

# Comprobación automática de actualizaciones al iniciar la aplicación.
# Usa true en las compilaciones de producción.
VITE_CHECK_UPDATES_ON_STARTUP=false

# Pusher Channels (tiempo real). Deben coincidir con el backend-laravel:
#   VITE_PUSHER_APP_KEY     = PUSHER_APP_KEY
#   VITE_PUSHER_APP_CLUSTER = PUSHER_APP_CLUSTER
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=sa1
